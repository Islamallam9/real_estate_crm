rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function platformAdminData() {
      return get(
        /databases/$(database)/documents/platform_admins/$(request.auth.uid)
      ).data;
    }

    function isActivePlatformAdmin() {
      return signedIn() && platformAdminData().isActive == true;
    }

    function currentMembershipData(companyId) {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(companyId)
      ).data;
    }

    function hasMembership(companyId) {
      return signedIn() && currentMembershipData(companyId).companyId == companyId;
    }

    function currentUserData(companyId) {
      return get(
        /databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid)
      ).data;
    }

    function isActiveCompanyUser(companyId) {
      return signedIn()
        && currentUserData(companyId).companyId == companyId
        && currentUserData(companyId).isActive == true;
    }

    function role(companyId) {
      return currentUserData(companyId).role;
    }

    function isAdmin(companyId) {
      return isActiveCompanyUser(companyId) && role(companyId) == 'admin';
    }

    function isAdminOrManager(companyId) {
      return isActiveCompanyUser(companyId)
        && role(companyId) in ['admin', 'manager'];
    }

    function isSalesAgent(companyId) {
      return isActiveCompanyUser(companyId) && role(companyId) == 'salesAgent';
    }

    function isMarketing(companyId) {
      return isActiveCompanyUser(companyId) && role(companyId) == 'marketing';
    }

    function isViewer(companyId) {
      return isActiveCompanyUser(companyId) && role(companyId) == 'viewer';
    }

    function isStringOrNull(value) {
      return value == null || value is string;
    }

    function optionalStringField(data, field) {
      return !(field in data.keys())
        || data[field] == null
        || data[field] is string;
    }

    function isNumberOrNull(value) {
      return value == null || value is number;
    }

    function isTimestampOrNull(value) {
      return value == null || value is timestamp;
    }

    function validBaseCreate(companyId, recordId) {
      return request.resource.data.id == recordId
        && request.resource.data.companyId == companyId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validBaseUpdate(companyId) {
      return request.resource.data.id == resource.data.id
        && request.resource.data.companyId == companyId
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt is timestamp;
    }

    function activeAssignedRecord(data) {
      return data.assignedTo == request.auth.uid;
    }

    function companyReadableRecord(companyId) {
      return isAdmin(companyId);
    }

    function managerScopedRecord(companyId, data) {
      return isActiveCompanyUser(companyId)
        && role(companyId) == 'manager'
        && (
          data.assignedTo == request.auth.uid
          || data.managerId == request.auth.uid
          || (data.teamId is string
            && data.teamId != ''
            && data.teamId == currentUserData(companyId).teamId)
        );
    }

    function commonCrmRead(companyId) {
      return isActiveCompanyUser(companyId);
    }

    function leadFields() {
      return [
        'id',
        'companyId',
        'fullName',
        'phone',
        'email',
        'source',
        'sourceDetails',
        'status',
        'priority',
        'budgetMin',
        'budgetMax',
        'preferredLocation',
        'preferredPropertyType',
        'assignedTo',
        'assignedToName',
        'assignedToEmail',
        'teamId',
        'teamName',
        'managerId',
        'managerName',
        'notes',
        'createdAt',
        'updatedAt',
        'createdBy',
        'updatedBy',
        'lastContactAt',
        'nextFollowUpAt',
        'isArchived',
        'archivedAt',
        'archivedBy'
      ];
    }

    function validLeadData(companyId, leadId) {
      return request.resource.data.keys().hasAll([
          'id',
          'companyId',
          'fullName',
          'phone',
          'email',
          'source',
          'status',
          'priority',
          'budgetMin',
          'budgetMax',
          'preferredLocation',
          'preferredPropertyType',
          'assignedTo',
          'notes',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly(leadFields())
        && request.resource.data.id == leadId
        && request.resource.data.companyId == companyId
        && request.resource.data.fullName is string
        && request.resource.data.phone is string
        && request.resource.data.email is string
        && request.resource.data.source in [
          'facebook',
          'website',
          'phoneCall',
          'whatsapp',
          'referral',
          'walkIn',
          'other'
        ]
        && request.resource.data.status in [
          'new',
          'contacted',
          'interested',
          'visitScheduled',
          'negotiation',
          'won',
          'lost'
        ]
        && request.resource.data.priority in ['low', 'medium', 'high']
        && request.resource.data.budgetMin is number
        && request.resource.data.budgetMax is number
        && request.resource.data.preferredLocation is string
        && request.resource.data.preferredPropertyType is string
        && request.resource.data.assignedTo is string
        && isStringOrNull(request.resource.data.sourceDetails)
        && isStringOrNull(request.resource.data.assignedToName)
        && isStringOrNull(request.resource.data.assignedToEmail)
        && isStringOrNull(request.resource.data.teamId)
        && isStringOrNull(request.resource.data.teamName)
        && isStringOrNull(request.resource.data.managerId)
        && isStringOrNull(request.resource.data.managerName)
        && request.resource.data.notes is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.updatedBy is string
        && isTimestampOrNull(request.resource.data.lastContactAt)
        && isTimestampOrNull(request.resource.data.nextFollowUpAt)
        && (request.resource.data.isArchived == null
          || request.resource.data.isArchived is bool)
        && isTimestampOrNull(request.resource.data.archivedAt)
        && isStringOrNull(request.resource.data.archivedBy);
    }

    function canReadLead(companyId) {
      return companyReadableRecord(companyId)
        || managerScopedRecord(companyId, resource.data)
        || (isSalesAgent(companyId) && activeAssignedRecord(resource.data))
        || (isMarketing(companyId) && activeAssignedRecord(resource.data))
        || (isViewer(companyId) && activeAssignedRecord(resource.data));
    }

    function canCreateLead(companyId) {
      return isAdmin(companyId)
        || managerCanCreateAssignedRecord(companyId, request.resource.data)
        || ((isSalesAgent(companyId) || isMarketing(companyId))
          && request.resource.data.assignedTo == request.auth.uid);
    }

    function managerCanCreateAssignedRecord(companyId, data) {
      return isActiveCompanyUser(companyId)
        && role(companyId) == 'manager'
        && data.assignedTo is string
        && data.assignedTo != ''
        && get(/databases/$(database)/documents/companies/$(companyId)/users/$(data.assignedTo)).data.isActive == true
        && get(/databases/$(database)/documents/companies/$(companyId)/users/$(data.assignedTo)).data.managerId == request.auth.uid;
    }


    function optionalSnapshotFieldEmpty(data, field) {
      return !(field in data.keys()) || data[field] == null || data[field] == '';
    }

    function optionalSnapshotFieldMatches(data, field, expected) {
      return !(field in data.keys())
        || data[field] == expected
        || (data[field] == '' && expected == null);
    }

    function profileSnapshotFieldMatches(data, profile, field) {
      return data[field] == profile[field]
        || (!(field in profile.keys()) && data[field] == '')
        || (profile[field] == null && data[field] == '');
    }

    function snapshotFieldUnchangedOrEmptyDefault(data, field) {
      return data[field] == resource.data[field]
        || (!(field in resource.data.keys()) && data[field] == '')
        || (resource.data[field] == null && data[field] == '');
    }

    function assignmentFieldsUnchangedOrEmptyDefaults(data) {
      return data.assignedTo == resource.data.assignedTo
        && snapshotFieldUnchangedOrEmptyDefault(data, 'assignedToName')
        && snapshotFieldUnchangedOrEmptyDefault(data, 'assignedToEmail')
        && snapshotFieldUnchangedOrEmptyDefault(data, 'teamId')
        && snapshotFieldUnchangedOrEmptyDefault(data, 'teamName')
        && snapshotFieldUnchangedOrEmptyDefault(data, 'managerId')
        && snapshotFieldUnchangedOrEmptyDefault(data, 'managerName');
    }

    function assignmentSnapshotEmpty(data) {
      return data.assignedTo == ''
        && optionalSnapshotFieldEmpty(data, 'assignedToName')
        && optionalSnapshotFieldEmpty(data, 'assignedToEmail')
        && optionalSnapshotFieldEmpty(data, 'teamId')
        && optionalSnapshotFieldEmpty(data, 'teamName')
        && optionalSnapshotFieldEmpty(data, 'managerId')
        && optionalSnapshotFieldEmpty(data, 'managerName');
    }

    function assignedUserData(companyId, assignedTo) {
      return get(
        /databases/$(database)/documents/companies/$(companyId)/users/$(assignedTo)
      ).data;
    }

    function managerCanAssignUser(companyId, assignedTo) {
      return role(companyId) != 'manager'
        || assignedUserData(companyId, assignedTo).managerId == request.auth.uid
        || (assignedUserData(companyId, assignedTo).teamId is string
          && assignedUserData(companyId, assignedTo).teamId != ''
          && assignedUserData(companyId, assignedTo).teamId == currentUserData(companyId).teamId);
    }

    function assignmentSnapshotMatches(companyId, data, allowedRoles) {
      return data.assignedTo is string
        && data.assignedTo != ''
        && assignedUserData(companyId, data.assignedTo).isActive == true
        && assignedUserData(companyId, data.assignedTo).role in allowedRoles
        && optionalStringField(data, 'assignedToName')
        && optionalStringField(data, 'assignedToEmail')
        && optionalStringField(data, 'teamId')
        && optionalStringField(data, 'teamName')
        && optionalStringField(data, 'managerId')
        && optionalStringField(data, 'managerName')
        && managerCanAssignUser(companyId, data.assignedTo);
    }

    function validAssignmentSnapshot(companyId, data, allowedRoles) {
      return data.assignedTo == ''
        ? assignmentSnapshotEmpty(data)
        : assignmentSnapshotMatches(companyId, data, allowedRoles);
    }

    function assignmentFieldsUnchangedOrValid(companyId, data, allowedRoles) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'assignedTo',
          'assignedToName',
          'assignedToEmail',
          'teamId',
          'teamName',
          'managerId',
          'managerName'
        ])
        || assignmentFieldsUnchangedOrEmptyDefaults(data)
        || validAssignmentSnapshot(companyId, data, allowedRoles);
    }

    function nonArchivedLeadWrite() {
      return request.resource.data.isArchived == false
        && request.resource.data.archivedAt == null
        && (request.resource.data.archivedBy == null
          || request.resource.data.archivedBy == '');
    }

    function canUpdateLead(companyId) {
      return isAdmin(companyId)
        || managerScopedRecord(companyId, resource.data)
        || ((isSalesAgent(companyId) || isMarketing(companyId))
          && resource.data.assignedTo == request.auth.uid
          && request.resource.data.assignedTo == request.auth.uid
          && nonArchivedLeadWrite()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'fullName',
            'phone',
            'email',
            'source',
            'sourceDetails',
            'status',
            'priority',
            'budgetMin',
            'budgetMax',
            'preferredLocation',
            'preferredPropertyType',
            'assignedTo',
            'assignedToName',
            'teamId',
            'teamName',
            'managerId',
            'managerName',
            'notes',
            'lastContactAt',
            'nextFollowUpAt',
            'isArchived',
            'archivedAt',
            'archivedBy',
            'updatedAt',
            'updatedBy'
          ]));
    }

    function clientFields() {
      return [
        'id',
        'companyId',
        'fullName',
        'phone',
        'email',
        'budgetMin',
        'budgetMax',
        'preferredLocation',
        'preferredPropertyType',
        'notes',
        'assignedTo',
        'assignedToName',
        'assignedToEmail',
        'teamId',
        'teamName',
        'managerId',
        'managerName',
        'isActive',
        'createdAt',
        'updatedAt',
        'createdBy',
        'updatedBy'
      ];
    }

    function validClientData(companyId, clientId) {
      return request.resource.data.keys().hasAll([
          'id',
          'companyId',
          'fullName',
          'phone',
          'email',
          'preferredLocation',
          'preferredPropertyType',
          'notes',
          'assignedTo',
          'assignedToName',
          'assignedToEmail',
          'isActive',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly(clientFields())
        && request.resource.data.id == clientId
        && request.resource.data.companyId == companyId
        && request.resource.data.fullName is string
        && request.resource.data.phone is string
        && request.resource.data.email is string
        && isNumberOrNull(request.resource.data.budgetMin)
        && isNumberOrNull(request.resource.data.budgetMax)
        && request.resource.data.preferredLocation is string
        && request.resource.data.preferredPropertyType is string
        && request.resource.data.notes is string
        && request.resource.data.assignedTo is string
        && request.resource.data.assignedToName is string
        && request.resource.data.assignedToEmail is string
        && optionalStringField(request.resource.data, 'teamId')
        && optionalStringField(request.resource.data, 'teamName')
        && optionalStringField(request.resource.data, 'managerId')
        && optionalStringField(request.resource.data, 'managerName')
        && request.resource.data.isActive is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.updatedBy is string;
    }

    function canReadClient(companyId) {
      return companyReadableRecord(companyId)
        || managerScopedRecord(companyId, resource.data)
        || (isSalesAgent(companyId) && activeAssignedRecord(resource.data))
        || (isViewer(companyId) && activeAssignedRecord(resource.data));
    }

    function propertyFields() {
      return [
        'id',
        'companyId',
        'title',
        'description',
        'propertyType',
        'listingType',
        'price',
        'area',
        'bedrooms',
        'bathrooms',
        'location',
        'compound',
        'status',
        'ownerName',
        'ownerPhone',
        'assignedTo',
        'teamId',
        'teamName',
        'managerId',
        'managerName',
        'imageUrls',
        'coverImageUrl',
        'imageStoragePaths',
        'createdAt',
        'updatedAt',
        'createdBy',
        'updatedBy'
      ];
    }

    function validPropertyData(companyId, propertyId) {
      return request.resource.data.keys().hasAll([
          'id',
          'companyId',
          'title',
          'description',
          'propertyType',
          'listingType',
          'price',
          'area',
          'bedrooms',
          'bathrooms',
          'location',
          'compound',
          'status',
          'ownerName',
          'ownerPhone',
          'assignedTo',
          'imageUrls',
          'coverImageUrl',
          'imageStoragePaths',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly(propertyFields())
        && request.resource.data.id == propertyId
        && request.resource.data.companyId == companyId
        && request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.propertyType in [
          'apartment',
          'villa',
          'office',
          'shop',
          'land',
          'studio',
          'duplex',
          'penthouse'
        ]
        && request.resource.data.listingType in ['sale', 'rent']
        && request.resource.data.price is number
        && request.resource.data.area is number
        && request.resource.data.bedrooms is number
        && request.resource.data.bathrooms is number
        && request.resource.data.location is string
        && request.resource.data.compound is string
        && request.resource.data.status in [
          'available',
          'reserved',
          'sold',
          'rented',
          'inactive'
        ]
        && request.resource.data.ownerName is string
        && request.resource.data.ownerPhone is string
        && request.resource.data.assignedTo is string
        && optionalStringField(request.resource.data, 'teamId')
        && optionalStringField(request.resource.data, 'teamName')
        && optionalStringField(request.resource.data, 'managerId')
        && optionalStringField(request.resource.data, 'managerName')
        && request.resource.data.imageUrls is list
        && isStringOrNull(request.resource.data.coverImageUrl)
        && request.resource.data.imageStoragePaths is list
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.updatedBy is string;
    }

    function taskFields() {
      return [
        'id',
        'companyId',
        'title',
        'description',
        'assignedTo',
        'assignedToName',
        'assignedToEmail',
        'teamId',
        'teamName',
        'managerId',
        'managerName',
        'relatedType',
        'relatedId',
        'relatedTitle',
        'relatedSubtitle',
        'dueDate',
        'status',
        'priority',
        'createdAt',
        'updatedAt',
        'createdBy',
        'updatedBy',
        'isActive'
      ];
    }

    function validTaskData(companyId, taskId) {
      return request.resource.data.keys().hasAll([
          'id',
          'companyId',
          'title',
          'description',
          'assignedTo',
          'assignedToName',
          'assignedToEmail',
          'relatedType',
          'relatedId',
          'relatedTitle',
          'relatedSubtitle',
          'dueDate',
          'status',
          'priority',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy',
          'isActive'
        ])
        && request.resource.data.keys().hasOnly(taskFields())
        && request.resource.data.id == taskId
        && request.resource.data.companyId == companyId
        && request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.assignedTo is string
        && request.resource.data.assignedToName is string
        && request.resource.data.assignedToEmail is string
        && optionalStringField(request.resource.data, 'teamId')
        && optionalStringField(request.resource.data, 'teamName')
        && optionalStringField(request.resource.data, 'managerId')
        && optionalStringField(request.resource.data, 'managerName')
        && request.resource.data.relatedType in [
          'lead',
          'client',
          'property',
          'deal',
          'general'
        ]
        && request.resource.data.relatedId is string
        && request.resource.data.relatedTitle is string
        && request.resource.data.relatedSubtitle is string
        && isTimestampOrNull(request.resource.data.dueDate)
        && request.resource.data.status in [
          'pending',
          'inProgress',
          'completed',
          'cancelled'
        ]
        && request.resource.data.priority in ['low', 'medium', 'high']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.updatedBy is string
        && request.resource.data.isActive is bool;
    }

    function canReadTask(companyId) {
      return companyReadableRecord(companyId)
        || managerScopedRecord(companyId, resource.data)
        || (isSalesAgent(companyId) && activeAssignedRecord(resource.data))
        || (isMarketing(companyId) && activeAssignedRecord(resource.data))
        || (isViewer(companyId) && activeAssignedRecord(resource.data));
    }

    function canReadAppointment(companyId) {
      return companyReadableRecord(companyId)
        || managerScopedRecord(companyId, resource.data)
        || (isSalesAgent(companyId) && activeAssignedRecord(resource.data))
        || (isMarketing(companyId) && activeAssignedRecord(resource.data));
    }

    function canUpdateTask(companyId) {
      return isAdmin(companyId)
        || managerScopedRecord(companyId, resource.data)
        || (isSalesAgent(companyId)
          && resource.data.assignedTo == request.auth.uid
          && request.resource.data.assignedTo == request.auth.uid
          && request.resource.data.assignedToName == resource.data.assignedToName
          && request.resource.data.assignedToEmail == resource.data.assignedToEmail);
    }

    function dealFields() {
      return [
        'id',
        'companyId',
        'clientId',
        'clientName',
        'clientEmail',
        'clientPhone',
        'leadId',
        'leadName',
        'leadPhone',
        'propertyId',
        'propertyTitle',
        'propertyLocation',
        'assignedTo',
        'assignedToName',
        'assignedToEmail',
        'teamId',
        'teamName',
        'managerId',
        'managerName',
        'stage',
        'expectedValue',
        'commission',
        'closingDate',
        'lostReason',
        'notes',
        'isActive',
        'createdAt',
        'updatedAt',
        'createdBy',
        'updatedBy'
      ];
    }

    function validDealData(companyId, dealId) {
      return request.resource.data.keys().hasAll([
          'id',
          'companyId',
          'clientId',
          'clientName',
          'clientEmail',
          'clientPhone',
          'leadId',
          'leadName',
          'leadPhone',
          'propertyId',
          'propertyTitle',
          'propertyLocation',
          'assignedTo',
          'assignedToName',
          'assignedToEmail',
          'stage',
          'expectedValue',
          'commission',
          'closingDate',
          'lostReason',
          'notes',
          'isActive',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly(dealFields())
        && request.resource.data.id == dealId
        && request.resource.data.companyId == companyId
        && request.resource.data.clientId is string
        && request.resource.data.clientName is string
        && request.resource.data.clientEmail is string
        && request.resource.data.clientPhone is string
        && request.resource.data.leadId is string
        && request.resource.data.leadName is string
        && request.resource.data.leadPhone is string
        && request.resource.data.propertyId is string
        && request.resource.data.propertyTitle is string
        && request.resource.data.propertyLocation is string
        && request.resource.data.assignedTo is string
        && request.resource.data.assignedToName is string
        && request.resource.data.assignedToEmail is string
        && optionalStringField(request.resource.data, 'teamId')
        && optionalStringField(request.resource.data, 'teamName')
        && optionalStringField(request.resource.data, 'managerId')
        && optionalStringField(request.resource.data, 'managerName')
        && request.resource.data.stage in [
          'new',
          'qualified',
          'proposal',
          'negotiation',
          'won',
          'lost'
        ]
        && request.resource.data.expectedValue is number
        && request.resource.data.commission is number
        && isTimestampOrNull(request.resource.data.closingDate)
        && request.resource.data.lostReason is string
        && request.resource.data.notes is string
        && request.resource.data.isActive is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.updatedBy is string;
    }

    function canReadDeal(companyId) {
      return companyReadableRecord(companyId)
        || managerScopedRecord(companyId, resource.data)
        || (isSalesAgent(companyId) && activeAssignedRecord(resource.data))
        || (isViewer(companyId) && activeAssignedRecord(resource.data));
    }

    function canUpdateDeal(companyId) {
      return isAdmin(companyId)
        || managerScopedRecord(companyId, resource.data)
        || (isSalesAgent(companyId)
          && resource.data.assignedTo == request.auth.uid
          && request.resource.data.assignedTo == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'stage',
            'lostReason',
            'updatedAt',
            'updatedBy'
          ]));
    }

    function userProfileFields() {
      return [
        'uid',
        'companyId',
        'fullName',
        'email',
        'phone',
        'role',
        'isActive',
        'createdAt',
        'updatedAt',
        'createdBy',
        'updatedBy',
        'teamId',
        'teamName',
        'managerId',
        'managerName',
        'photoUrl',
        'photoStoragePath',
        'lastLoginAt',
        'lastLoginIp',
        'lastLoginUserAgent',
        'lastLoginPlatform',
        'lastLoginBrowser',
        'lastLoginDeviceType',
        'lastLoginLocale',
        'lastLoginTimezone'
      ];
    }

    function loginSummaryFields() {
      return [
        'lastLoginAt',
        'lastLoginIp',
        'lastLoginUserAgent',
        'lastLoginPlatform',
        'lastLoginBrowser',
        'lastLoginDeviceType',
        'lastLoginLocale',
        'lastLoginTimezone'
      ];
    }

    function validUserProfile(companyId, userId) {
      return request.resource.data.keys().hasAll([
          'uid',
          'companyId',
          'fullName',
          'email',
          'phone',
          'role',
          'isActive',
          'createdAt',
          'updatedAt',
          'createdBy'
        ])
        && request.resource.data.keys().hasOnly(userProfileFields())
        && request.resource.data.uid == userId
        && request.resource.data.companyId == companyId
        && request.resource.data.fullName is string
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.role in [
          'admin',
          'manager',
          'salesAgent',
          'marketing',
          'viewer'
        ]
        && request.resource.data.isActive is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.createdBy is string
        && isStringOrNull(request.resource.data.updatedBy)
        && optionalStringField(request.resource.data, 'teamId')
        && optionalStringField(request.resource.data, 'teamName')
        && optionalStringField(request.resource.data, 'managerId')
        && optionalStringField(request.resource.data, 'managerName')
        && optionalStringField(request.resource.data, 'photoUrl')
        && optionalStringField(request.resource.data, 'photoStoragePath')
        && (request.resource.data.teamId == null
          || request.resource.data.teamId == ''
          || request.resource.data.role in ['salesAgent', 'marketing'])
        && isTimestampOrNull(request.resource.data.lastLoginAt)
        && isStringOrNull(request.resource.data.lastLoginIp)
        && isStringOrNull(request.resource.data.lastLoginUserAgent)
        && isStringOrNull(request.resource.data.lastLoginPlatform)
        && isStringOrNull(request.resource.data.lastLoginBrowser)
        && isStringOrNull(request.resource.data.lastLoginDeviceType)
        && isStringOrNull(request.resource.data.lastLoginLocale)
        && isStringOrNull(request.resource.data.lastLoginTimezone);
    }

    function canReadUserProfile(companyId, userId) {
      return (signedIn() && userId == request.auth.uid)
        || isActivePlatformAdmin()
        || isAdmin(companyId)
        || (isAdminOrManager(companyId)
          && resource.data.managerId == request.auth.uid
          && resource.data.isActive == true);
    }

    function teamFields() {
      return [
        'id',
        'companyId',
        'name',
        'description',
        'managerId',
        'managerName',
        'managerEmail',
        'isActive',
        'memberCount',
        'createdAt',
        'createdBy',
        'updatedAt',
        'updatedBy'
      ];
    }

    function validTeamData(companyId, teamId) {
      return request.resource.data.keys().hasAll([
          'id',
          'companyId',
          'name',
          'description',
          'managerId',
          'managerName',
          'managerEmail',
          'isActive',
          'memberCount',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly(teamFields())
        && request.resource.data.id == teamId
        && request.resource.data.companyId == companyId
        && request.resource.data.name is string
        && request.resource.data.description is string
        && request.resource.data.managerId is string
        && request.resource.data.managerName is string
        && request.resource.data.managerEmail is string
        && request.resource.data.isActive is bool
        && request.resource.data.memberCount is number
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == request.auth.uid
        && get(/databases/$(database)/documents/companies/$(companyId)/users/$(request.resource.data.managerId)).data.role == 'manager'
        && get(/databases/$(database)/documents/companies/$(companyId)/users/$(request.resource.data.managerId)).data.isActive == true;
    }

    function auditLogFields() {
      return [
        'id',
        'companyId',
        'actorId',
        'actorName',
        'actorEmail',
        'actorRole',
        'action',
        'module',
        'recordId',
        'recordTitle',
        'recordSubtitle',
        'assignedTo',
        'teamId',
        'teamName',
        'managerId',
        'managerName',
        'createdAt',
        'metadata'
      ];
    }

    function validAuditLogActorSnapshot(companyId) {
      return currentUserData(companyId).fullName == request.resource.data.actorName
        && currentUserData(companyId).email == request.resource.data.actorEmail
        && currentUserData(companyId).role == request.resource.data.actorRole;
    }

    function validAuditLogCreate(companyId, auditLogId) {
      return isActiveCompanyUser(companyId)
        && request.resource.data.keys().hasAll(auditLogFields())
        && request.resource.data.keys().hasOnly(auditLogFields())
        && request.resource.data.id == auditLogId
        && request.resource.data.companyId == companyId
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.actorName is string
        && request.resource.data.actorEmail is string
        && request.resource.data.actorRole == role(companyId)
        && validAuditLogActorSnapshot(companyId)
        && request.resource.data.actorRole in [
          'admin',
          'manager',
          'salesAgent',
          'marketing',
          'viewer'
        ]
        && request.resource.data.action in [
          'create',
          'update',
          'archive',
          'deactivate',
          'assign',
          'statusChange',
          'stageChange',
          'complete',
          'cancel',
          'imageAdded',
          'imageRemoved'
        ]
        && request.resource.data.module in [
          'leads',
          'clients',
          'properties',
          'tasks',
          'deals'
        ]
        && request.resource.data.recordId is string
        && request.resource.data.recordTitle is string
        && request.resource.data.recordSubtitle is string
        && request.resource.data.assignedTo is string
        && request.resource.data.teamId is string
        && request.resource.data.teamName is string
        && request.resource.data.managerId is string
        && request.resource.data.managerName is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.metadata is map;
    }

    function validNotificationReadStateUpdate(companyId) {
      return isActiveCompanyUser(companyId)
        && resource.data.companyId == companyId
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.recipientUid == resource.data.recipientUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isRead',
          'readAt',
          'updatedAt'
        ])
        && request.resource.data.isRead is bool
        && isTimestampOrNull(request.resource.data.readAt)
        && isTimestampOrNull(request.resource.data.updatedAt);
    }

    match /platform_admins/{adminId} {
      allow get: if signedIn()
        && (request.auth.uid == adminId || isActivePlatformAdmin());
      allow list: if isActivePlatformAdmin();
      allow update: if signedIn()
        && request.auth.uid == adminId
        && resource.data.isActive == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName',
          'photoUrl',
          'photoStoragePath',
          'updatedAt',
          'updatedBy'
        ])
        && optionalStringField(request.resource.data, 'fullName')
        && optionalStringField(request.resource.data, 'photoUrl')
        && optionalStringField(request.resource.data, 'photoStoragePath')
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt is timestamp;
      allow create, delete: if false;
    }

    match /platform_login_activity/{eventId} {
      allow get, list: if isActivePlatformAdmin();
      allow create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if signedIn()
        && (request.auth.uid == userId || isActivePlatformAdmin());
      allow list: if isActivePlatformAdmin();
      allow create, update, delete: if false;

      match /memberships/{companyId} {
        allow get, list: if signedIn()
          && (request.auth.uid == userId || isActivePlatformAdmin());
        allow create, update, delete: if false;
      }
    }

    match /companies/{companyId} {
      allow get: if isActivePlatformAdmin()
        || isActiveCompanyUser(companyId)
        || hasMembership(companyId);
      allow list: if isActivePlatformAdmin();
      allow create, update: if false;
      allow delete: if false;

      match /users/{userId} {
        allow get, list: if isActivePlatformAdmin()
          || canReadUserProfile(companyId, userId);
        allow create: if isAdmin(companyId)
          && validUserProfile(companyId, userId)
          && request.resource.data.createdBy == request.auth.uid
          && !request.resource.data.keys().hasAny(loginSummaryFields());
        allow update: if (isAdmin(companyId)
            && validUserProfile(companyId, userId)
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.companyId == resource.data.companyId
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.createdAt == resource.data.createdAt
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(loginSummaryFields())
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'teamId',
              'teamName',
              'managerId',
              'managerName'
            ]))
          || (signedIn()
            && request.auth.uid == userId
            && isActiveCompanyUser(companyId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'fullName',
              'photoUrl',
              'photoStoragePath',
              'updatedAt',
              'updatedBy'
            ])
            && optionalStringField(request.resource.data, 'fullName')
            && optionalStringField(request.resource.data, 'photoUrl')
            && optionalStringField(request.resource.data, 'photoStoragePath')
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.updatedAt is timestamp);
        allow delete: if false;
      }

      match /teams/{teamId} {
        allow get, list: if isActivePlatformAdmin()
          || isAdmin(companyId)
          || (isAdminOrManager(companyId)
            && resource.data.managerId == request.auth.uid);
        allow create: if isAdmin(companyId)
          && validTeamData(companyId, teamId)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isAdmin(companyId)
          && validTeamData(companyId, teamId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }

      match /leads/{leadId} {
        allow get, list: if isActivePlatformAdmin()
          || (commonCrmRead(companyId) && canReadLead(companyId));
        allow create: if isActiveCompanyUser(companyId)
          && canCreateLead(companyId)
          && validLeadData(companyId, leadId)
          && validBaseCreate(companyId, leadId)
          && validAssignmentSnapshot(companyId, request.resource.data, ['salesAgent', 'marketing'])
          && (request.resource.data.isArchived == null
            || request.resource.data.isArchived == false);
        allow update: if isActiveCompanyUser(companyId)
          && canUpdateLead(companyId)
          && validLeadData(companyId, leadId)
          && validBaseUpdate(companyId)
          && assignmentFieldsUnchangedOrValid(
            companyId,
            request.resource.data,
            ['salesAgent', 'marketing']
          );
        allow delete: if false;

        match /notes/{noteId} {
          allow get, list: if commonCrmRead(companyId)
            && (companyReadableRecord(companyId)
              || managerScopedRecord(
                companyId,
                get(/databases/$(database)/documents/companies/$(companyId)/leads/$(leadId)).data
              )
              || get(/databases/$(database)/documents/companies/$(companyId)/leads/$(leadId)).data.assignedTo == request.auth.uid);
          allow create: if isActiveCompanyUser(companyId)
            && request.resource.data.keys().hasOnly([
              'id',
              'leadId',
              'companyId',
              'text',
              'createdAt',
              'createdBy'
            ])
            && request.resource.data.id == noteId
            && request.resource.data.leadId == leadId
            && request.resource.data.companyId == companyId
            && request.resource.data.text is string
            && request.resource.data.createdAt is timestamp
            && request.resource.data.createdBy == request.auth.uid
            && (isAdmin(companyId)
              || managerScopedRecord(
                companyId,
                get(/databases/$(database)/documents/companies/$(companyId)/leads/$(leadId)).data
              )
              || get(/databases/$(database)/documents/companies/$(companyId)/leads/$(leadId)).data.assignedTo == request.auth.uid);
          allow update, delete: if false;
        }

        match /timeline/{eventId} {
          allow get, list: if commonCrmRead(companyId)
            && (companyReadableRecord(companyId)
              || managerScopedRecord(
                companyId,
                get(/databases/$(database)/documents/companies/$(companyId)/leads/$(leadId)).data
              )
              || get(/databases/$(database)/documents/companies/$(companyId)/leads/$(leadId)).data.assignedTo == request.auth.uid);
          allow create: if isActiveCompanyUser(companyId)
            && request.resource.data.keys().hasOnly([
              'id',
              'leadId',
              'companyId',
              'type',
              'title',
              'description',
              'oldValue',
              'newValue',
              'createdAt',
              'createdBy',
              'createdByName',
              'metadata'
            ])
            && request.resource.data.id == eventId
            && request.resource.data.leadId == leadId
            && request.resource.data.companyId == companyId
            && request.resource.data.type is string
            && request.resource.data.type in [
              'created',
              'statusChanged',
              'assigned',
              'noteAdded',
              'followUpSet',
              'contacted',
              'stageChanged',
              'archived',
              'reassigned',
              'updated'
            ]
            && request.resource.data.title is string
            && request.resource.data.description is string
            && request.resource.data.oldValue is string
            && request.resource.data.newValue is string
            && request.resource.data.createdAt is timestamp
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.createdByName is string
            && request.resource.data.metadata is map
            && (isAdmin(companyId)
              || managerScopedRecord(
                companyId,
                get(/databases/$(database)/documents/companies/$(companyId)/leads/$(leadId)).data
              )
              || get(/databases/$(database)/documents/companies/$(companyId)/leads/$(leadId)).data.assignedTo == request.auth.uid);
          allow update, delete: if false;
        }
      }

      match /clients/{clientId} {
        allow get, list: if isActivePlatformAdmin()
          || (commonCrmRead(companyId) && canReadClient(companyId));
        allow create: if (isAdmin(companyId)
            || managerCanCreateAssignedRecord(companyId, request.resource.data))
          && validClientData(companyId, clientId)
          && validBaseCreate(companyId, clientId)
          && validAssignmentSnapshot(companyId, request.resource.data, ['salesAgent'])
          && request.resource.data.isActive == true;
        allow update: if (isAdmin(companyId)
            || managerScopedRecord(companyId, resource.data))
          && validClientData(companyId, clientId)
          && validBaseUpdate(companyId)
          && assignmentFieldsUnchangedOrValid(
            companyId,
            request.resource.data,
            ['salesAgent']
          );
        allow delete: if false;
      }

      match /properties/{propertyId} {
        allow get, list: if isActivePlatformAdmin()
          || (commonCrmRead(companyId)
            && role(companyId) in [
              'admin',
              'manager',
              'salesAgent',
              'marketing',
              'viewer'
            ]);
        allow create: if isAdminOrManager(companyId)
          && validPropertyData(companyId, propertyId)
          && validBaseCreate(companyId, propertyId);
        allow update: if isAdminOrManager(companyId)
          && validPropertyData(companyId, propertyId)
          && validBaseUpdate(companyId);
        allow delete: if false;
      }

      match /tasks/{taskId} {
        allow get, list: if isActivePlatformAdmin()
          || (commonCrmRead(companyId) && canReadTask(companyId));
        allow create: if (isAdmin(companyId)
            || managerCanCreateAssignedRecord(companyId, request.resource.data))
          && validTaskData(companyId, taskId)
          && validBaseCreate(companyId, taskId)
          && validAssignmentSnapshot(companyId, request.resource.data, ['salesAgent', 'marketing'])
          && request.resource.data.isActive == true;
        allow update: if isActiveCompanyUser(companyId)
          && canUpdateTask(companyId)
          && validTaskData(companyId, taskId)
          && validBaseUpdate(companyId)
          && assignmentFieldsUnchangedOrValid(
            companyId,
            request.resource.data,
            ['salesAgent', 'marketing']
          );
        allow delete: if false;
      }

      match /appointments/{appointmentId} {
        allow get, list: if commonCrmRead(companyId)
          && canReadAppointment(companyId);
        allow create, update, delete: if false;
      }

      match /deals/{dealId} {
        allow get, list: if isActivePlatformAdmin()
          || (commonCrmRead(companyId) && canReadDeal(companyId));
        allow create: if (isAdmin(companyId)
            || managerCanCreateAssignedRecord(companyId, request.resource.data))
          && validDealData(companyId, dealId)
          && validBaseCreate(companyId, dealId)
          && validAssignmentSnapshot(companyId, request.resource.data, ['salesAgent'])
          && request.resource.data.isActive == true;
        allow update: if isActiveCompanyUser(companyId)
          && canUpdateDeal(companyId)
          && validDealData(companyId, dealId)
          && validBaseUpdate(companyId)
          && assignmentFieldsUnchangedOrValid(
            companyId,
            request.resource.data,
            ['salesAgent']
          );
        allow delete: if false;
      }

      match /audit_logs/{auditLogId} {
        allow get, list: if isActivePlatformAdmin()
          || isAdmin(companyId)
          || (isActiveCompanyUser(companyId)
            && role(companyId) == 'manager'
            && (
              resource.data.managerId == request.auth.uid
              || resource.data.actorId == request.auth.uid
              || (resource.data.teamId is string
                && resource.data.teamId != ''
                && resource.data.teamId == currentUserData(companyId).teamId)
            ));
        allow create: if validAuditLogCreate(companyId, auditLogId);
        allow update, delete: if false;
      }

      match /login_activity/{eventId} {
        allow get, list: if isActivePlatformAdmin()
          || isAdmin(companyId)
          || (isActiveCompanyUser(companyId) && resource.data.uid == request.auth.uid);
        allow create, update, delete: if false;
      }

      match /appointments/{appointmentId} {
        allow read, write: if false;
      }

      match /notifications/{notificationId} {
        allow get: if isActiveCompanyUser(companyId)
          && resource.data.companyId == companyId
          && resource.data.recipientUid == request.auth.uid;
        allow list: if isActiveCompanyUser(companyId)
          && resource.data.recipientUid == request.auth.uid;
        allow update: if validNotificationReadStateUpdate(companyId);
        allow create, delete: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }
  }
}

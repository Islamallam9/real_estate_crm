rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function platformAdminData() {
      return get(
        /databases/$(database)/documents/platform_admins/$(request.auth.uid)
      ).data;
    }

    function isActivePlatformAdmin() {
      return signedIn() && platformAdminData().isActive == true;
    }

    function currentMembershipData(companyId) {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(companyId)
      ).data;
    }

    function hasMembership(companyId) {
      return signedIn() && currentMembershipData(companyId).companyId == companyId;
    }

    function companyData(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)).data;
    }

    function companyOpenForCrm(companyId) {
      let company = companyData(companyId);
      return company.isActive == true
        && (
          !company.keys().hasAny(['status'])
          || company.status == 'active'
          || (company.status == 'trial'
            && company.trialEndsAt is timestamp
            && company.trialEndsAt > request.time)
        )
        && (
          !company.keys().hasAny(['paymentStatus'])
          || company.paymentStatus != 'suspended'
        )
        && (
          !company.keys().hasAny(['paymentStatus'])
          || company.paymentStatus != 'gracePeriod'
          || (company.gracePeriodEndsAt is timestamp
            && company.gracePeriodEndsAt > request.time)
        );
    }

    function currentUserData(companyId) {
      return get(
        /databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid)
      ).data;
    }

    function isActiveCompanyUser(companyId) {
      return signedIn()
        && companyOpenForCrm(companyId)
        && currentUserData(companyId).companyId == companyId
        && currentUserData(companyId).isActive == true;
    }

    function role(companyId) {
      return currentUserData(companyId).role;
    }

    function isAdmin(companyId) {
      return isActiveCompanyUser(companyId) && role(companyId) == 'admin';
    }

    function isManager(companyId) {
      return isActiveCompanyUser(companyId) && role(companyId) == 'manager';
    }

    function isAdminOrManager(companyId) {
      return isActiveCompanyUser(companyId)
        && role(companyId) in ['admin', 'manager'];
    }

    function isSalesAgent(companyId) {
      return isActiveCompanyUser(companyId) && role(companyId) == 'salesAgent';
    }

    function isMarketing(companyId) {
      return isActiveCompanyUser(companyId) && role(companyId) == 'marketing';
    }

    function isViewer(companyId) {
      return isActiveCompanyUser(companyId) && role(companyId) == 'viewer';
    }

    function companyFeatureEnabled(companyId, feature) {
      return !get(/databases/$(database)/documents/companies/$(companyId)).data.keys().hasAny(['features'])
        || !(get(/databases/$(database)/documents/companies/$(companyId)).data.features is map)
        || !(get(/databases/$(database)/documents/companies/$(companyId)).data.features[feature] is bool)
        || get(/databases/$(database)/documents/companies/$(companyId)).data.features[feature] == true;
    }

    function isStringOrNull(value) {
      return value == null || value is string;
    }

    function optionalStringField(data, field) {
      return !(field in data.keys())
        || data[field] == null
        || data[field] is string;
    }

    function isNumberOrNull(value) {
      return value == null || value is number;
    }

    function isTimestampOrNull(value) {
      return value == null || value is timestamp;
    }

    function validBaseCreate(companyId, recordId) {
      return request.resource.data.id == recordId
        && request.resource.data.companyId == companyId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validBaseUpdate(companyId) {
      return request.resource.data.id == resource.data.id
        && request.resource.data.companyId == companyId
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt is timestamp;
    }

    function taskIdUnchangedOrLegacyHydrated(taskId) {
      return request.resource.data.id == taskId;
    }

    function taskCompanyIdUnchangedOrLegacyHydrated(companyId) {
      return ('companyId' in resource.data.keys()
          && resource.data.companyId is string
          && resource.data.companyId != '')
        ? request.resource.data.companyId == resource.data.companyId
        : request.resource.data.companyId == companyId;
    }

    function taskCreatedByUnchangedOrLegacyHydrated() {
      return ('createdBy' in resource.data.keys()
          && resource.data.createdBy is string
          && resource.data.createdBy != '')
        ? request.resource.data.createdBy == resource.data.createdBy
        : (request.resource.data.createdBy is string
          && request.resource.data.createdBy != '');
    }

    function taskCreatedAtUnchangedOrLegacyHydrated() {
      return ('createdAt' in resource.data.keys()
          && resource.data.createdAt is timestamp)
        ? request.resource.data.createdAt == resource.data.createdAt
        : request.resource.data.createdAt is timestamp;
    }

    function taskIsActiveUnchangedOrLegacyHydrated() {
      return ('isActive' in resource.data.keys()
          && resource.data.isActive is bool)
        ? request.resource.data.isActive == resource.data.isActive
        : request.resource.data.isActive == true;
    }

    function validTaskBaseUpdate(companyId, taskId) {
      return request.resource.data.id == taskId
        && request.resource.data.companyId == companyId
        && taskIdUnchangedOrLegacyHydrated(taskId)
        && taskCompanyIdUnchangedOrLegacyHydrated(companyId)
        && taskCreatedByUnchangedOrLegacyHydrated()
        && taskCreatedAtUnchangedOrLegacyHydrated()
        && taskIsActiveUnchangedOrLegacyHydrated()
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt is timestamp;
    }

    function activeAssignedRecord(data) {
      return data.assignedTo == request.auth.uid;
    }

    function activeAssignedActiveRecord(data) {
      return activeAssignedRecord(data)
        && data.isActive == true;
    }

    function activeAssignedUnarchivedRecord(data) {
      return activeAssignedRecord(data)
        && (data.isArchived == null || data.isArchived == false);
    }

    function activeAssignedActiveUnarchivedRecord(data) {
      return activeAssignedActiveRecord(data)
        && (data.isArchived == null || data.isArchived == false);
    }

    function companyReadableRecord(companyId) {
      return isAdmin(companyId);
    }

    function managerScopedRecord(companyId, data) {
      return isActiveCompanyUser(companyId)
        && role(companyId) == 'manager'
        && (
          data.assignedTo == request.auth.uid
          || data.managerId == request.auth.uid
          || (data.teamId is string
            && data.teamId != ''
            && data.teamId == currentUserData(companyId).teamId)
        );
    }

    function commonCrmRead(companyId) {
      return isActiveCompanyUser(companyId);
    }

    function leadFields() {
      return [
        'id',
        'companyId',
        'fullName',
        'phone',
        'phoneNormalized',
        'email',
        'emailNormalized',
        'source',
        'sourceDetails',
        'status',
        'priority',
        'budgetMin',
        'budgetMax',
        'preferredLocation',
        'preferredPropertyType',
        'assignedTo',
        'assignedToName',
        'assignedToEmail',
        'teamId',
        'teamName',
        'managerId',
        'managerName',
        'notes',
        'createdAt',
        'updatedAt',
        'createdBy',
        'updatedBy',
        'lastContactAt',
        'nextFollowUpAt',
        'isArchived',
        'archivedAt',
        'archivedBy',
        'archivedByName',
        'archiveReason',
        'restoredAt',
        'restoredBy',
        'restoredByName'
      ];
    }

    function validLeadData(companyId, leadId) {
      return request.resource.data.keys().hasAll([
          'id',
          'companyId',
          'fullName',
          'phone',
          'email',
          'source',
          'status',
          'priority',
          'budgetMin',
          'budgetMax',
          'preferredLocation',
          'preferredPropertyType',
          'assignedTo',
          'notes',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly(leadFields())
        && request.resource.data.id == leadId
        && request.resource.data.companyId == companyId
        && request.resource.data.fullName is string
        && request.resource.data.phone is string
        && isStringOrNull(request.resource.data.phoneNormalized)
        && request.resource.data.email is string
        && isStringOrNull(request.resource.data.emailNormalized)
        && request.resource.data.source in [
          'facebook',
          'website',
          'phoneCall',
          'whatsapp',
          'referral',
          'walkIn',
          'other'
        ]
        && request.resource.data.status in [
          'new',
          'contacted',
          'interested',
          'visitScheduled',
          'negotiation',
          'won',
          'lost'
        ]
        && request.resource.data.priority in ['low', 'medium', 'high']
        && request.resource.data.budgetMin is number
        && request.resource.data.budgetMax is number
        && request.resource.data.budgetMin >= 0
        && request.resource.data.budgetMax >= 0
        && (request.resource.data.budgetMin == 0
          || request.resource.data.budgetMax == 0
          || request.resource.data.budgetMax >= request.resource.data.budgetMin)
        && request.resource.data.preferredLocation is string
        && request.resource.data.preferredPropertyType is string
        && request.resource.data.assignedTo is string
        && isStringOrNull(request.resource.data.sourceDetails)
        && isStringOrNull(request.resource.data.assignedToName)
        && isStringOrNull(request.resource.data.assignedToEmail)
        && isStringOrNull(request.resource.data.teamId)
        && isStringOrNull(request.resource.data.teamName)
        && isStringOrNull(request.resource.data.managerId)
        && isStringOrNull(request.resource.data.managerName)
        && request.resource.data.notes is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.updatedBy is string
        && isTimestampOrNull(request.resource.data.lastContactAt)
        && isTimestampOrNull(request.resource.data.nextFollowUpAt)
        && (request.resource.data.isArchived == null
          || request.resource.data.isArchived is bool)
        && isTimestampOrNull(request.resource.data.archivedAt)
        && isStringOrNull(request.resource.data.archivedBy)
        && isStringOrNull(request.resource.data.archivedByName)
        && isStringOrNull(request.resource.data.archiveReason)
        && isTimestampOrNull(request.resource.data.restoredAt)
        && isStringOrNull(request.resource.data.restoredBy)
        && isStringOrNull(request.resource.data.restoredByName);
    }

    function canReadLead(companyId) {
      return companyReadableRecord(companyId)
        || managerScopedRecord(companyId, resource.data)
        || (isSalesAgent(companyId) && activeAssignedUnarchivedRecord(resource.data))
        || (isMarketing(companyId) && activeAssignedUnarchivedRecord(resource.data))
        || (isViewer(companyId) && activeAssignedUnarchivedRecord(resource.data));
    }

    function canCreateLead(companyId) {
      return isAdmin(companyId)
        || managerCanCreateAssignedRecord(companyId, request.resource.data)
        || ((isSalesAgent(companyId) || isMarketing(companyId))
          && request.resource.data.assignedTo == request.auth.uid);
    }

    function managerCanCreateAssignedRecord(companyId, data) {
      return isActiveCompanyUser(companyId)
        && role(companyId) == 'manager'
        && data.assignedTo is string
        && data.assignedTo != ''
        && get(/databases/$(database)/documents/companies/$(companyId)/users/$(data.assignedTo)).data.isActive == true
        && (
          data.assignedTo == request.auth.uid
          || get(/databases/$(database)/documents/companies/$(companyId)/users/$(data.assignedTo)).data.managerId == request.auth.uid
          || (get(/databases/$(database)/documents/companies/$(companyId)/users/$(data.assignedTo)).data.teamId is string
            && get(/databases/$(database)/documents/companies/$(companyId)/users/$(data.assignedTo)).data.teamId != ''
            && get(/databases/$(database)/documents/companies/$(companyId)/users/$(data.assignedTo)).data.teamId == currentUserData(companyId).teamId)
        );
    }


    function optionalSnapshotFieldEmpty(data, field) {
      return !(field in data.keys()) || data[field] == null || data[field] == '';
    }


    function profileSnapshotFieldMatches(data, profile, field) {
      return data[field] == profile[field]
        || (!(field in profile.keys()) && data[field] == '')
        || (profile[field] == null && data[field] == '');
    }

    function profileDisplayNameSnapshotMatches(data, profile, field) {
      return data[field] == profile.fullName
        || ((!(profile.fullName is string) || profile.fullName == '')
          && data[field] == profile.email)
        || ((!(profile.fullName is string) || profile.fullName == '')
          && !(profile.email is string)
          && data[field] == '');
    }

    function profileEmailSnapshotMatches(data, profile) {
      return data.assignedToEmail == profile.email
        || (!(profile.email is string) && data.assignedToEmail == '');
    }

    function snapshotFieldUnchangedOrEmptyDefault(data, field) {
      return data[field] == resource.data[field]
        || (!(field in resource.data.keys()) && data[field] == '')
        || (resource.data[field] == null && data[field] == '');
    }

    function assignmentFieldsUnchangedOrEmptyDefaults(data) {
      return data.assignedTo == resource.data.assignedTo
        && snapshotFieldUnchangedOrEmptyDefault(data, 'assignedToName')
        && snapshotFieldUnchangedOrEmptyDefault(data, 'assignedToEmail')
        && snapshotFieldUnchangedOrEmptyDefault(data, 'teamId')
        && snapshotFieldUnchangedOrEmptyDefault(data, 'teamName')
        && snapshotFieldUnchangedOrEmptyDefault(data, 'managerId')
        && snapshotFieldUnchangedOrEmptyDefault(data, 'managerName');
    }

    function assignmentSnapshotEmpty(data) {
      return data.assignedTo == ''
        && optionalSnapshotFieldEmpty(data, 'assignedToName')
        && optionalSnapshotFieldEmpty(data, 'assignedToEmail')
        && optionalSnapshotFieldEmpty(data, 'teamId')
        && optionalSnapshotFieldEmpty(data, 'teamName')
        && optionalSnapshotFieldEmpty(data, 'managerId')
        && optionalSnapshotFieldEmpty(data, 'managerName');
    }

    function assignedUserData(companyId, assignedTo) {
      return get(
        /databases/$(database)/documents/companies/$(companyId)/users/$(assignedTo)
      ).data;
    }

    function managerCanAssignUser(companyId, assignedTo) {
      return role(companyId) != 'manager'
        || assignedTo == request.auth.uid
        || assignedUserData(companyId, assignedTo).managerId == request.auth.uid
        || (assignedUserData(companyId, assignedTo).teamId is string
          && assignedUserData(companyId, assignedTo).teamId != ''
          && assignedUserData(companyId, assignedTo).teamId == currentUserData(companyId).teamId);
    }

    function assignmentSnapshotMatches(companyId, data, allowedRoles) {
      return data.assignedTo is string
        && data.assignedTo != ''
        && assignedUserData(companyId, data.assignedTo).isActive == true
        && assignedUserData(companyId, data.assignedTo).role in allowedRoles
        && optionalStringField(data, 'assignedToName')
        && optionalStringField(data, 'assignedToEmail')
        && optionalStringField(data, 'teamId')
        && optionalStringField(data, 'teamName')
        && optionalStringField(data, 'managerId')
        && optionalStringField(data, 'managerName')
        && managerCanAssignUser(companyId, data.assignedTo);
    }

    function validAssignmentSnapshot(companyId, data, allowedRoles) {
      return data.assignedTo == ''
        ? assignmentSnapshotEmpty(data)
        : assignmentSnapshotMatches(companyId, data, allowedRoles);
    }

    function validDealCreateAssignmentSnapshot(companyId, data) {
      return validAssignmentSnapshot(companyId, data, ['salesAgent']);
    }

    function assignmentFieldsUnchangedOrValid(companyId, data, allowedRoles) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'assignedTo',
          'assignedToName',
          'assignedToEmail',
          'teamId',
          'teamName',
          'managerId',
          'managerName'
        ])
        || assignmentFieldsUnchangedOrEmptyDefaults(data)
        || validAssignmentSnapshot(companyId, data, allowedRoles);
    }

    function nonArchivedLeadWrite() {
      return request.resource.data.isArchived == false
        && request.resource.data.archivedAt == null
        && (request.resource.data.archivedBy == null
          || request.resource.data.archivedBy == '');
    }

    function archiveBoolUnchanged(field, defaultValue) {
      return (field in resource.data.keys())
        ? request.resource.data[field] == resource.data[field]
        : (!(field in request.resource.data.keys())
          || request.resource.data[field] == defaultValue
          || request.resource.data[field] == null);
    }

    function archiveStringUnchanged(field) {
      return (field in resource.data.keys())
        ? request.resource.data[field] == resource.data[field]
        : (!(field in request.resource.data.keys())
          || request.resource.data[field] == ''
          || request.resource.data[field] == null);
    }

    function archiveTimestampUnchanged(field) {
      return (field in resource.data.keys())
        ? request.resource.data[field] == resource.data[field]
        : (!(field in request.resource.data.keys())
          || request.resource.data[field] == null);
    }

    function archiveFieldsUnchanged() {
      return archiveBoolUnchanged('isArchived', false)
        && archiveTimestampUnchanged('archivedAt')
        && archiveStringUnchanged('archivedBy')
        && archiveStringUnchanged('archivedByName')
        && archiveStringUnchanged('archiveReason')
        && archiveTimestampUnchanged('restoredAt')
        && archiveStringUnchanged('restoredBy')
        && archiveStringUnchanged('restoredByName');
    }

    function canUpdateLead(companyId) {
      return isAdmin(companyId)
        || managerScopedRecord(companyId, resource.data)
        || ((isSalesAgent(companyId) || isMarketing(companyId))
          && resource.data.assignedTo == request.auth.uid
          && request.resource.data.assignedTo == request.auth.uid
          && nonArchivedLeadWrite()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'fullName',
            'phone',
            'phoneNormalized',
            'email',
            'emailNormalized',
            'source',
            'sourceDetails',
            'status',
            'priority',
            'budgetMin',
            'budgetMax',
            'preferredLocation',
            'preferredPropertyType',
            'assignedTo',
            'assignedToName',
            'teamId',
            'teamName',
            'managerId',
            'managerName',
            'notes',
            'lastContactAt',
            'nextFollowUpAt',
            'isArchived',
            'archivedAt',
            'archivedBy',
            'updatedAt',
            'updatedBy'
          ]));
    }

    function clientFields() {
      return [
        'id',
        'companyId',
        'fullName',
        'phone',
        'email',
        'budgetMin',
        'budgetMax',
        'preferredLocation',
        'preferredPropertyType',
        'notes',
        'assignedTo',
        'assignedToName',
        'assignedToEmail',
        'teamId',
        'teamName',
        'managerId',
        'managerName',
        'isActive',
        'isArchived',
        'archivedAt',
        'archivedBy',
        'archivedByName',
        'archiveReason',
        'restoredAt',
        'restoredBy',
        'restoredByName',
        'createdAt',
        'updatedAt',
        'createdBy',
        'updatedBy'
      ];
    }

    function validClientData(companyId, clientId) {
      return request.resource.data.keys().hasAll([
          'id',
          'companyId',
          'fullName',
          'phone',
          'email',
          'preferredLocation',
          'preferredPropertyType',
          'notes',
          'assignedTo',
          'assignedToName',
          'assignedToEmail',
          'isActive',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly(clientFields())
        && request.resource.data.id == clientId
        && request.resource.data.companyId == companyId
        && request.resource.data.fullName is string
        && request.resource.data.phone is string
        && request.resource.data.email is string
        && isNumberOrNull(request.resource.data.budgetMin)
        && isNumberOrNull(request.resource.data.budgetMax)
        && request.resource.data.preferredLocation is string
        && request.resource.data.preferredPropertyType is string
        && request.resource.data.notes is string
        && request.resource.data.assignedTo is string
        && request.resource.data.assignedToName is string
        && request.resource.data.assignedToEmail is string
        && optionalStringField(request.resource.data, 'teamId')
        && optionalStringField(request.resource.data, 'teamName')
        && optionalStringField(request.resource.data, 'managerId')
        && optionalStringField(request.resource.data, 'managerName')
        && request.resource.data.isActive is bool
        && (request.resource.data.isArchived == null
          || request.resource.data.isArchived is bool)
        && isTimestampOrNull(request.resource.data.archivedAt)
        && optionalStringField(request.resource.data, 'archivedBy')
        && optionalStringField(request.resource.data, 'archivedByName')
        && optionalStringField(request.resource.data, 'archiveReason')
        && isTimestampOrNull(request.resource.data.restoredAt)
        && optionalStringField(request.resource.data, 'restoredBy')
        && optionalStringField(request.resource.data, 'restoredByName')
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.updatedBy is string;
    }

    function clientDetailsUpdateFields() {
      return [
        'fullName',
        'phone',
        'email',
        'budgetMin',
        'budgetMax',
        'preferredLocation',
        'preferredPropertyType',
        'notes',
        'updatedAt',
        'updatedBy'
      ];
    }

    function clientProtectedDetailsFields() {
      return [
        'id',
        'companyId',
        'assignedTo',
        'assignedToName',
        'assignedToEmail',
        'teamId',
        'teamName',
        'managerId',
        'managerName',
        'isActive',
        'isArchived',
        'archivedAt',
        'archivedBy',
        'archivedByName',
        'archiveReason',
        'restoredAt',
        'restoredBy',
        'restoredByName',
        'createdAt',
        'createdBy'
      ];
    }

    function clientProtectedDetailsFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(clientProtectedDetailsFields());
    }

    function clientDocumentIdUnchangedOrLegacyMissing() {
      return !('id' in resource.data.keys())
        || request.resource.data.id == resource.data.id;
    }

    function validClientDetailsUpdate(companyId) {
      return isActiveCompanyUser(companyId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(clientDetailsUpdateFields())
        && clientProtectedDetailsFieldsUnchanged()
        && clientDocumentIdUnchangedOrLegacyMissing()
        && request.resource.data.companyId == companyId
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.fullName is string
        && request.resource.data.phone is string
        && request.resource.data.email is string
        && isNumberOrNull(request.resource.data.budgetMin)
        && isNumberOrNull(request.resource.data.budgetMax)
        && request.resource.data.preferredLocation is string
        && request.resource.data.preferredPropertyType is string
        && request.resource.data.notes is string
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt is timestamp;
    }

    function validClientFullUpdate(companyId, clientId) {
      return archiveFieldsUnchanged()
        && validClientData(companyId, clientId)
        && validBaseUpdate(companyId)
        && assignmentFieldsUnchangedOrValid(
          companyId,
          request.resource.data,
          ['salesAgent']
        );
    }

    function managerCanUpdateClientDetails(companyId) {
      return isManager(companyId)
        && managerScopedRecord(companyId, resource.data)
        && managerScopedRecord(companyId, request.resource.data)
        && validClientDetailsUpdate(companyId);
    }

    function managerCanUpdateClientFull(companyId, clientId) {
      return managerScopedRecord(companyId, resource.data)
        && validClientFullUpdate(companyId, clientId);
    }

    function canReadClient(companyId) {
      return companyReadableRecord(companyId)
        || managerScopedRecord(companyId, resource.data)
        || (isSalesAgent(companyId) && activeAssignedActiveUnarchivedRecord(resource.data))
        || (isViewer(companyId) && activeAssignedActiveUnarchivedRecord(resource.data));
    }

    function propertyFields() {
      return [
        'id',
        'companyId',
        'title',
        'description',
        'propertyType',
        'listingType',
        'price',
        'area',
        'bedrooms',
        'bathrooms',
        'location',
        'compound',
        'status',
        'ownerName',
        'ownerPhone',
        'assignedTo',
        'isArchived',
        'archivedAt',
        'archivedBy',
        'archivedByName',
        'archiveReason',
        'restoredAt',
        'restoredBy',
        'restoredByName',
        'teamId',
        'teamName',
        'managerId',
        'managerName',
        'imageUrls',
        'coverImageUrl',
        'imageStoragePaths',
        'createdAt',
        'updatedAt',
        'createdBy',
        'updatedBy'
      ];
    }

    function validPropertyData(companyId, propertyId) {
      return request.resource.data.keys().hasAll([
          'id',
          'companyId',
          'title',
          'description',
          'propertyType',
          'listingType',
          'price',
          'area',
          'bedrooms',
          'bathrooms',
          'location',
          'compound',
          'status',
          'ownerName',
          'ownerPhone',
          'assignedTo',
          'imageUrls',
          'coverImageUrl',
          'imageStoragePaths',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly(propertyFields())
        && request.resource.data.id == propertyId
        && request.resource.data.companyId == companyId
        && request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.propertyType in [
          'apartment',
          'villa',
          'office',
          'shop',
          'land',
          'studio',
          'duplex',
          'penthouse'
        ]
        && request.resource.data.listingType in ['sale', 'rent']
        && request.resource.data.price is number
        && request.resource.data.area is number
        && request.resource.data.bedrooms is number
        && request.resource.data.bathrooms is number
        && request.resource.data.location is string
        && request.resource.data.compound is string
        && request.resource.data.status in [
          'available',
          'reserved',
          'sold',
          'rented',
          'inactive'
        ]
        && request.resource.data.ownerName is string
        && request.resource.data.ownerPhone is string
        && request.resource.data.assignedTo is string
        && (request.resource.data.isArchived == null
          || request.resource.data.isArchived is bool)
        && isTimestampOrNull(request.resource.data.archivedAt)
        && optionalStringField(request.resource.data, 'archivedBy')
        && optionalStringField(request.resource.data, 'archivedByName')
        && optionalStringField(request.resource.data, 'archiveReason')
        && isTimestampOrNull(request.resource.data.restoredAt)
        && optionalStringField(request.resource.data, 'restoredBy')
        && optionalStringField(request.resource.data, 'restoredByName')
        && optionalStringField(request.resource.data, 'teamId')
        && optionalStringField(request.resource.data, 'teamName')
        && optionalStringField(request.resource.data, 'managerId')
        && optionalStringField(request.resource.data, 'managerName')
        && request.resource.data.imageUrls is list
        && isStringOrNull(request.resource.data.coverImageUrl)
        && request.resource.data.imageStoragePaths is list
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.updatedBy is string;
    }

    function taskFields() {
      return [
        'id',
        'companyId',
        'title',
        'description',
        'assignedTo',
        'assignedToName',
        'assignedToEmail',
        'teamId',
        'teamName',
        'managerId',
        'managerName',
        'relatedType',
        'relatedId',
        'relatedTitle',
        'relatedSubtitle',
        'dueDate',
        'status',
        'priority',
        'createdAt',
        'updatedAt',
        'createdBy',
        'updatedBy',
        'isActive'
      ];
    }

    function validTaskData(companyId, taskId) {
      return request.resource.data.keys().hasAll([
          'id',
          'companyId',
          'title',
          'description',
          'assignedTo',
          'assignedToName',
          'assignedToEmail',
          'relatedType',
          'relatedId',
          'relatedTitle',
          'relatedSubtitle',
          'dueDate',
          'status',
          'priority',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy',
          'isActive'
        ])
        && request.resource.data.keys().hasOnly(taskFields())
        && request.resource.data.id == taskId
        && request.resource.data.companyId == companyId
        && request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.assignedTo is string
        && request.resource.data.assignedToName is string
        && request.resource.data.assignedToEmail is string
        && optionalStringField(request.resource.data, 'teamId')
        && optionalStringField(request.resource.data, 'teamName')
        && optionalStringField(request.resource.data, 'managerId')
        && optionalStringField(request.resource.data, 'managerName')
        && request.resource.data.relatedType in [
          'lead',
          'client',
          'property',
          'deal',
          'general'
        ]
        && request.resource.data.relatedId is string
        && request.resource.data.relatedTitle is string
        && request.resource.data.relatedSubtitle is string
        && isTimestampOrNull(request.resource.data.dueDate)
        && request.resource.data.status in [
          'pending',
          'inProgress',
          'completed',
          'cancelled'
        ]
        && request.resource.data.priority in ['low', 'medium', 'high']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.updatedBy is string
        && request.resource.data.isActive is bool;
    }

    function isTaskSelfAssignment(data) {
      return data.assignedTo is string
        && data.assignedTo == request.auth.uid;
    }

    function taskAssignedUserSnapshotMatches(companyId, data) {
      let profile = assignedUserData(companyId, data.assignedTo);
      return data.assignedTo is string
        && data.assignedTo != ''
        && profile.isActive == true
        && profileDisplayNameSnapshotMatches(data, profile, 'assignedToName')
        && profileEmailSnapshotMatches(data, profile)
        && profileSnapshotFieldMatches(data, profile, 'teamId')
        && profileSnapshotFieldMatches(data, profile, 'teamName')
        && profileSnapshotFieldMatches(data, profile, 'managerId')
        && profileSnapshotFieldMatches(data, profile, 'managerName');
    }

    function taskManagerSelfAssignmentSnapshotMatches(companyId, data) {
      let profile = assignedUserData(companyId, data.assignedTo);
      return isTaskSelfAssignment(data)
        && profile.isActive == true
        && profile.role == 'manager'
        && profileDisplayNameSnapshotMatches(data, profile, 'assignedToName')
        && profileEmailSnapshotMatches(data, profile)
        && taskManagerSelfAssignmentTeamSnapshotMatches(data, profile)
        && data.managerId == request.auth.uid
        && profileDisplayNameSnapshotMatches(data, profile, 'managerName');
    }

    function taskActorSelfAssignmentSnapshotMatches(companyId, data) {
      return isTaskSelfAssignment(data)
        && (
          (role(companyId) == 'manager'
            && taskManagerSelfAssignmentSnapshotMatches(companyId, data))
          || ((role(companyId) == 'salesAgent'
              || role(companyId) == 'marketing')
            && taskAssignedUserSnapshotMatches(companyId, data))
        );
    }

    function canReadTask(companyId) {
      return companyReadableRecord(companyId)
        || managerScopedRecord(companyId, resource.data)
        || (isSalesAgent(companyId) && activeAssignedActiveRecord(resource.data))
        || (isMarketing(companyId) && activeAssignedActiveRecord(resource.data))
        || (isViewer(companyId) && activeAssignedActiveRecord(resource.data));
    }

    function canReadAppointment(companyId) {
      return companyReadableRecord(companyId)
        || managerScopedRecord(companyId, resource.data)
        || (isSalesAgent(companyId) && activeAssignedRecord(resource.data))
        || (isMarketing(companyId) && activeAssignedRecord(resource.data));
    }

    function taskAssignedUserRoleAllowed(companyId, data, allowedRoles) {
      return data.assignedTo is string
        && data.assignedTo != ''
        && assignedUserData(companyId, data.assignedTo).isActive == true
        && assignedUserData(companyId, data.assignedTo).role in allowedRoles;
    }

    function taskStrictAssignmentSnapshotMatches(companyId, data, allowedRoles) {
      return taskAssignedUserRoleAllowed(companyId, data, allowedRoles)
        && taskAssignedUserSnapshotMatches(companyId, data);
    }

    function taskManagerSelfAssignmentTeamSnapshotMatches(data, profile) {
      return ((!(profile.teamId is string) || profile.teamId == '')
          && data.teamId == ''
          && optionalSnapshotFieldEmpty(data, 'teamName'))
        || (profile.teamId is string
          && profile.teamId != ''
          && profileSnapshotFieldMatches(data, profile, 'teamId')
          && profileSnapshotFieldMatches(data, profile, 'teamName'));
    }

    function taskAssignmentFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'assignedTo',
        'assignedToName',
        'assignedToEmail',
        'teamId',
        'teamName',
        'managerId',
        'managerName'
      ]);
    }

    function taskAssignmentFieldsUnchanged() {
      return !taskAssignmentFieldsChanged();
    }

    function taskAssignmentSnapshotUnchanged() {
      return request.resource.data.assignedTo == resource.data.assignedTo
        && request.resource.data.assignedToName == resource.data.assignedToName
        && request.resource.data.assignedToEmail == resource.data.assignedToEmail
        && request.resource.data.teamId == resource.data.teamId
        && request.resource.data.teamName == resource.data.teamName
        && request.resource.data.managerId == resource.data.managerId
        && request.resource.data.managerName == resource.data.managerName;
    }


    function taskFullUpdateFieldsChangedAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'id',
        'companyId',
        'title',
        'description',
        'assignedTo',
        'assignedToName',
        'assignedToEmail',
        'teamId',
        'teamName',
        'managerId',
        'managerName',
        'relatedType',
        'relatedId',
        'relatedTitle',
        'relatedSubtitle',
        'dueDate',
        'status',
        'priority',
        'createdAt',
        'createdBy',
        'updatedAt',
        'updatedBy',
        'isActive'
      ]);
    }

    function taskAdminAssignmentAfterUpdateAllowed(companyId) {
      return taskAssignmentFieldsUnchanged()
        || taskAssignmentSnapshotUnchanged()
        || taskStrictAssignmentSnapshotMatches(
          companyId,
          request.resource.data,
          ['admin', 'manager', 'salesAgent', 'marketing']
        )
        || taskActorSelfAssignmentSnapshotMatches(companyId, request.resource.data);
    }


    function taskManagerReassignmentFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'assignedTo',
        'assignedToName',
        'assignedToEmail',
        'teamId',
        'teamName',
        'managerId',
        'managerName',
        'updatedAt',
        'updatedBy'
      ]);
    }

    function taskManagerContentFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'title',
        'description',
        'relatedType',
        'relatedId',
        'relatedTitle',
        'relatedSubtitle',
        'dueDate',
        'status',
        'priority',
        'updatedAt',
        'updatedBy'
      ]);
    }


    function taskAdminUpdateShapeAllowed(companyId) {
      return taskFullUpdateFieldsChangedAllowed()
        && taskAdminAssignmentAfterUpdateAllowed(companyId);
    }

    function taskSalesMarketingUpdateShapeAllowed(companyId) {
      return resource.data.assignedTo == request.auth.uid
        && request.resource.data.assignedTo == request.auth.uid
        && taskFullUpdateFieldsChangedAllowed()
        && (
          taskAssignmentFieldsUnchanged()
          || taskAssignmentSnapshotUnchanged()
        );
    }

    function taskManagerExistingScopeForActor(companyId, actor) {
      return resource.data.assignedTo == request.auth.uid
        || resource.data.managerId == request.auth.uid
        || (resource.data.teamId is string
          && resource.data.teamId != ''
          && (
            (actor.teamId is string
              && actor.teamId != ''
              && resource.data.teamId == actor.teamId)
            || managesTeamById(companyId, resource.data.teamId)
          ));
    }

    function taskManagerTargetScopeForActor(companyId, actor) {
      return request.resource.data.assignedTo == request.auth.uid
        || request.resource.data.managerId == request.auth.uid
        || (request.resource.data.teamId is string
          && request.resource.data.teamId != ''
          && (
            (actor.teamId is string
              && actor.teamId != ''
              && request.resource.data.teamId == actor.teamId)
            || managesTeamById(companyId, request.resource.data.teamId)
          ));
    }

    function taskManagerSelfReassignShapeAllowed(companyId, actor) {
      return taskManagerExistingScopeForActor(companyId, actor)
        && taskManagerReassignmentFieldsOnly()
        && request.resource.data.assignedTo == request.auth.uid
        && request.resource.data.managerId == request.auth.uid
        && request.resource.data.assignedToName is string
        && request.resource.data.assignedToEmail is string
        && optionalStringField(request.resource.data, 'teamId')
        && optionalStringField(request.resource.data, 'teamName')
        && optionalStringField(request.resource.data, 'managerName')
        && (
          !(request.resource.data.teamId is string)
          || request.resource.data.teamId == ''
          || (actor.teamId is string
            && actor.teamId != ''
            && request.resource.data.teamId == actor.teamId)
          || managesTeamById(companyId, request.resource.data.teamId)
        );
    }

    function taskManagerStaffReassignShapeAllowed(companyId, actor) {
      let assignedUser = assignedUserData(
        companyId,
        request.resource.data.assignedTo
      );
      return taskManagerExistingScopeForActor(companyId, actor)
        && taskManagerReassignmentFieldsOnly()
        && request.resource.data.assignedTo is string
        && request.resource.data.assignedTo != ''
        && assignedUser.isActive == true
        && assignedUser.role in ['salesAgent', 'marketing']
        && request.resource.data.managerId == request.auth.uid
        && request.resource.data.assignedToName is string
        && request.resource.data.assignedToEmail is string
        && optionalStringField(request.resource.data, 'teamId')
        && optionalStringField(request.resource.data, 'teamName')
        && optionalStringField(request.resource.data, 'managerName')
        && (
          assignedUser.managerId == request.auth.uid
          || (request.resource.data.teamId is string
            && request.resource.data.teamId != ''
            && assignedUser.teamId == request.resource.data.teamId
            && (
              managesTeamById(companyId, request.resource.data.teamId)
              || (actor.teamId is string
                && actor.teamId != ''
                && assignedUser.teamId == actor.teamId)
            ))
        );
    }

    function taskManagerContentShapeAllowed(companyId, actor) {
      return taskManagerExistingScopeForActor(companyId, actor)
        && taskManagerTargetScopeForActor(companyId, actor)
        && taskAssignmentSnapshotUnchanged()
        && taskManagerContentFieldsOnly();
    }

    function taskManagerUpdateRoutedAllowed(companyId, actor) {
      return taskManagerSelfReassignShapeAllowed(companyId, actor)
        || taskManagerStaffReassignShapeAllowed(companyId, actor)
        || taskManagerContentShapeAllowed(companyId, actor);
    }

    function taskUpdateAllowed(companyId, taskId) {
      let actor = currentUserData(companyId);
      return validTaskData(companyId, taskId)
        && validTaskBaseUpdate(companyId, taskId)
        && signedIn()
        && companyOpenForCrm(companyId)
        && actor.companyId == companyId
        && actor.isActive == true
        && (
          (actor.role == 'admin'
            && taskAdminUpdateShapeAllowed(companyId))
          || (actor.role == 'manager'
            && taskManagerUpdateRoutedAllowed(companyId, actor))
          || ((actor.role == 'salesAgent' || actor.role == 'marketing')
            && taskSalesMarketingUpdateShapeAllowed(companyId))
        );
    }

    function taskAdminCreateAllowed(companyId) {
      return isAdmin(companyId)
        && taskStrictAssignmentSnapshotMatches(
          companyId,
          request.resource.data,
          ['admin', 'manager', 'salesAgent', 'marketing']
        );
    }

    function taskManagerCreateAllowed(companyId) {
      return isManager(companyId)
        && (
          taskActorSelfAssignmentSnapshotMatches(companyId, request.resource.data)
          || (managerCanCreateAssignedRecord(companyId, request.resource.data)
            && taskStrictAssignmentSnapshotMatches(
              companyId,
              request.resource.data,
              ['salesAgent', 'marketing']
            ))
        );
    }

    function taskSalesMarketingCreateAllowed(companyId) {
      return (isSalesAgent(companyId) || isMarketing(companyId))
        && request.resource.data.assignedTo == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && taskActorSelfAssignmentSnapshotMatches(companyId, request.resource.data);
    }

    function taskCreateAllowed(companyId, taskId) {
      return validTaskData(companyId, taskId)
        && validBaseCreate(companyId, taskId)
        && request.resource.data.isActive == true
        && (
          taskAdminCreateAllowed(companyId)
          || taskManagerCreateAllowed(companyId)
          || taskSalesMarketingCreateAllowed(companyId)
        );
    }

    function dealFields() {
      return [
        'id',
        'companyId',
        'clientId',
        'clientName',
        'clientEmail',
        'clientPhone',
        'leadId',
        'leadName',
        'leadPhone',
        'propertyId',
        'propertyTitle',
        'propertyLocation',
        'assignedTo',
        'assignedToName',
        'assignedToEmail',
        'teamId',
        'teamName',
        'managerId',
        'managerName',
        'stage',
        'expectedValue',
        'commission',
        'closingDate',
        'lostReason',
        'notes',
        'isActive',
        'isArchived',
        'archivedAt',
        'archivedBy',
        'archivedByName',
        'archiveReason',
        'restoredAt',
        'restoredBy',
        'restoredByName',
        'createdAt',
        'updatedAt',
